{
  "compatibility_date": "2026-05-23",
  "assets": {
    "directory": "./docs"
  },
  
  // Explicit environments configuration.
  // Non-production development happens against a local Supabase stack, which a deployed
  // Worker cannot reach, so there is no hosted dev environment.
  "env": {
    "production": {
      "name": "dicethrone-prod"
    }
  }
}